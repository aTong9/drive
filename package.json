{
  "name": "roadlens-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:data": "node scripts/validate-data.mjs",
    "demo:plan": "tsx src/cli/plan.ts",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/check-bundle-size.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "test:services": "tsx --test src/services/*.test.ts",
    "test": "npm run validate:data && npm run typecheck && npm run test:services && npm run demo:plan"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "ajv": "8.17.1",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@amap/amap-jsapi-types": "^0.0.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "4.20.3",
    "typescript": "5.9.2",
    "vite": "^8.2.1"
  }
}
