{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadlens.local/schemas/davinci-workflow-v1.json",
  "title": "RoadLens DaVinci Workflow v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "product", "sourceUrl", "stages"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 5 },
    "product": { "type": "string", "minLength": 5 },
    "sourceUrl": { "type": "string", "pattern": "^https://www\\.blackmagicdesign\\.com/" },
    "stages": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "englishLabel", "summary", "output", "tasks"],
        "properties": {
          "id": { "enum": ["media", "photo", "cut", "edit", "fusion", "color", "fairlight", "deliver"] },
          "label": { "type": "string", "minLength": 2 },
          "englishLabel": { "type": "string", "minLength": 3 },
          "summary": { "type": "string", "minLength": 8 },
          "output": { "type": "string", "minLength": 8 },
          "tasks": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 8 } }
        }
      }
    }
  }
}
