{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadlens.local/schemas/youtube-creators.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "methodology", "accessedAt", "creators"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "methodology": { "type": "string", "minLength": 20 },
    "accessedAt": { "type": "string", "format": "date" },
    "creators": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/creator" } }
  },
  "$defs": {
    "link": { "type": "object", "additionalProperties": false, "required": ["title", "url"], "properties": { "title": { "type": "string", "minLength": 2 }, "url": { "type": "string", "format": "uri" } } },
    "representative": { "type": "object", "additionalProperties": false, "required": ["title", "url", "observedPerformance"], "properties": { "title": { "type": "string", "minLength": 3 }, "url": { "type": "string", "format": "uri" }, "observedPerformance": { "type": "string", "minLength": 10 } } },
    "creator": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "region", "category", "channelUrl", "positioning", "representative", "whyItWorks", "patterns", "caution", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "name": { "type": "string", "minLength": 2 }, "region": { "type": "string", "minLength": 2 },
        "category": { "enum": ["scenic-drive", "rain-walk", "stationary-nature", "urban-walk", "guided-walk", "cinematic-landscape"] },
        "channelUrl": { "type": "string", "format": "uri" }, "positioning": { "type": "string", "minLength": 10 },
        "representative": { "$ref": "#/$defs/representative" },
        "whyItWorks": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 10 } },
        "patterns": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 4 } },
        "caution": { "type": "string", "minLength": 10 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/link" } }
      }
    }
  }
}
