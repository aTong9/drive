{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadlens.local/schemas/catalog-v2.json",
  "title": "RoadLens Catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "locations", "cameraPresets", "routes", "shootPlans"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "locations": { "type": "array", "items": { "$ref": "#/$defs/location" } },
    "cameraPresets": { "type": "array", "items": { "$ref": "#/$defs/cameraPreset" } },
    "routes": { "type": "array", "items": { "$ref": "#/$defs/route" } },
    "shootPlans": { "type": "array", "items": { "$ref": "#/$defs/shootPlan" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "accessedAt", "supports"],
      "properties": {
        "title": { "type": "string", "minLength": 2 },
        "url": { "type": "string", "pattern": "^https://" },
        "accessedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["existence", "address", "coordinate", "access", "shooting-value"] }
        }
      }
    },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lng", "crs"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 },
        "crs": { "enum": ["GCJ-02", "WGS84"] }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "province", "city", "type", "coordinate", "access", "shooting", "soundEnvironment", "verification"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 2 },
        "province": { "type": "string", "minLength": 2 },
        "city": { "type": "string", "minLength": 2 },
        "type": { "enum": ["coast", "city-night", "waterfall", "stream", "forest", "mountain", "river", "lake", "landmark"] },
        "coordinate": { "$ref": "#/$defs/coordinate" },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "note"],
          "properties": {
            "mode": { "enum": ["drive", "park-and-walk"] },
            "note": { "type": "string", "minLength": 2 }
          }
        },
        "shooting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bestTimes", "bestWeather", "modes", "advice"],
          "properties": {
            "bestTimes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["sunrise", "morning", "golden-hour", "sunset", "blue-hour", "night"] } },
            "bestWeather": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["sunny", "cloudy", "after-rain", "fog", "rain"] } },
            "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["photo", "driving-video", "tripod-video", "timelapse", "asmr"] } },
            "advice": { "type": "string", "minLength": 10 }
          }
        },
        "soundEnvironment": {
          "type": "object", "additionalProperties": false,
          "required": ["character", "noiseRisk", "crowdRisk", "weatherSensitivity", "recordingAdvice"],
          "properties": {
            "character": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["waves", "water", "birds", "urban", "traffic", "mixed"] } },
            "noiseRisk": { "enum": ["low", "medium", "high"] },
            "crowdRisk": { "enum": ["low", "medium", "high"] },
            "weatherSensitivity": { "type": "string", "minLength": 5 },
            "recordingAdvice": { "type": "string", "minLength": 10 }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "sources"],
          "properties": {
            "status": { "enum": ["draft", "source-checked", "field-checked"] },
            "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
          }
        }
      }
    },
    "cameraPreset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "camera", "scene", "settings", "notes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "camera": { "type": "string", "minLength": 2 },
        "scene": { "enum": ["coast-sunset", "city-night-driving", "city-night-tripod", "forest-stream-static"] },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resolution", "fps", "shutter", "iso", "whiteBalanceKelvin"],
          "properties": {
            "resolution": { "type": "string", "minLength": 2 },
            "fps": { "type": "integer", "minimum": 1, "maximum": 240 },
            "shutter": { "type": "string", "pattern": "^1/\\d+$" },
            "iso": {
              "type": "object",
              "additionalProperties": false,
              "required": ["min", "max"],
              "properties": { "min": { "type": "integer", "minimum": 50 }, "max": { "type": "integer", "minimum": 50 } }
            },
            "whiteBalanceKelvin": { "type": "integer", "minimum": 2000, "maximum": 12000 },
            "aperture": { "type": "string", "pattern": "^F\\d+(?:\\.\\d+)?$" },
            "profile": { "type": "string", "minLength": 2 }
          }
        },
        "notes": { "type": "string", "minLength": 10 }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "province", "cities", "type", "captureStyle", "modes", "estimatedDurationMinutes", "waypointLocationIds", "best", "cameraPresetIds", "shootAdvice", "scores", "status", "verification"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 2 },
        "province": { "type": "string", "minLength": 2 },
        "cities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
        "type": { "enum": ["coast", "city-night", "mountain", "forest", "waterfall", "river", "lake"] },
        "captureStyle": { "enum": ["scenic-drive", "rain-walk", "stationary-nature"] },
        "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["day", "night", "sunrise", "sunset", "asmr"] } },
        "estimatedDurationMinutes": { "type": "integer", "minimum": 15 },
        "waypointLocationIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "best": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seasons", "times", "weather"],
          "properties": {
            "seasons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["spring", "summer", "autumn", "winter"] } },
            "times": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["sunrise", "morning", "golden-hour", "sunset", "blue-hour", "night"] } },
            "weather": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["sunny", "cloudy", "after-rain", "fog", "rain"] } }
          }
        },
        "cameraPresetIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "shootAdvice": { "type": "string", "minLength": 10 },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visual", "road", "parking", "safety", "youtubePotential"],
          "properties": {
            "visual": { "type": "integer", "minimum": 1, "maximum": 5 },
            "road": { "type": "integer", "minimum": 1, "maximum": 5 },
            "parking": { "type": "integer", "minimum": 1, "maximum": 5 },
            "safety": { "type": "integer", "minimum": 1, "maximum": 5 },
            "youtubePotential": { "type": "integer", "minimum": 1, "maximum": 5 }
          }
        },
        "status": { "enum": ["idea", "planned", "captured", "published"] },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "note"],
          "properties": {
            "status": { "enum": ["draft", "source-checked", "field-checked"] },
            "note": { "type": "string", "minLength": 10 }
          }
        }
      }
    },
    "shootPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "routeId", "scheduledDate", "status", "equipmentPresetIds", "objective"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "routeId": { "$ref": "#/$defs/id" },
        "scheduledDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "status": { "enum": ["idea", "planned", "captured", "published"] },
        "equipmentPresetIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "objective": { "type": "string", "minLength": 5 }
      }
    }
  }
}
