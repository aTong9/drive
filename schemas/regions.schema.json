{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadlens.local/schemas/regions.schema.json",
  "title": "RoadLens administrative region directory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "provinces"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "url", "retrievedAt"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "retrievedAt": { "type": "string", "format": "date" }
      }
    },
    "provinces": {
      "type": "array",
      "minItems": 34,
      "maxItems": 34,
      "items": { "$ref": "#/$defs/province" }
    }
  },
  "$defs": {
    "division": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "province": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "divisions"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "divisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/division" } }
      }
    }
  }
}
